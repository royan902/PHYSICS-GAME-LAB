{
  "name": "physics-game-lab",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "prebuild": "node tools/build-newton-html.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "format": "prettier --write src/games/billiard tests/physics tests/e2e/billiard.spec.ts vitest.config.mts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
